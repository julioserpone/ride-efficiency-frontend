{
    "name": "ride-efficiency-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "docker:dev": "docker compose up --build",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f web",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "types:check": "vue-tsc --build --force",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "format": "prettier --write \"src/**/*.{ts,vue,css,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\""
    },
    "dependencies": {
        "@primeuix/themes": "^1.2.5",
        "apexcharts": "^7.4.0",
        "axios": "^1.20.0",
        "pinia": "^4.0.3",
        "primeflex": "^4.0.0",
        "primeicons": "^8.0.1",
        "primevue": "^4.5.5",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1",
        "vue3-apexcharts": "^1.11.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.0",
        "jsdom": "^30.1.0",
        "prettier": "^3.9.8",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.11"
    },
    "description": "Web dashboard for Ride Efficiency: shift profitability, kilometres, fuel cost and net earnings."
}
