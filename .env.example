# Base URL of the ride-efficiency-api JSON API (includes the /v1 version prefix).
VITE_API_URL=http://localhost/api/v1
# Port of the Vite dev server on your host machine.
FRONTEND_PORT=5173

# Docker network of the `ride-efficiency-api` stack (Laravel Sail).
# `docker compose -f ../ride-efficiency-api/compose.yaml up -d` creates it as
# <project-directory>_sail; list it with `docker network ls`.
API_NETWORK=ride-efficiency-api_sail
